<Window x:Class="Vaganymester.TrainDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vonat belső nézete | VÁGÁNYMESTER"
        Width="1190" Height="780" MinWidth="960" MinHeight="610"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}">
    <Window.Resources>
        <Style x:Key="SeatButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="94"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#155047"/>
            <Setter Property="Foreground" Value="#EDFDFC"/>
            <Setter Property="BorderBrush" Value="#49DDB9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="ToolTip" Value="{Binding Description}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="SeatShell" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11" Margin="0,0,0,2">
                                <Grid>
                                    <Border Width="5" HorizontalAlignment="Left" Background="#61DEC3"
                                            CornerRadius="8,0,0,8" Margin="2,4,0,4"/>
                                    <ContentPresenter ContentSource="Content"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" Margin="7,2,2,2"/>
                                </Grid>
                            </Border>
                            <Border Height="5" VerticalAlignment="Bottom" Margin="12,0,12,0"
                                    Background="#385969" CornerRadius="0,0,5,5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SeatShell" Property="BorderBrush" Value="#F7F9FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SeatShell" Property="Opacity" Value="0.73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                    <Setter Property="Background" Value="#634932"/>
                    <Setter Property="BorderBrush" Value="#FFBF71"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="UTASTÉR ÉS HELYFOGLALTSÁG" FontSize="12" Foreground="#8BAEC1" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="28"/>
                    <TextBlock Text="  •  " FontSize="22" Foreground="#8BAEC1"/>
                    <TextBlock Text="{Binding KindText}" FontSize="21" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Célállomás: " Foreground="#9CB7C8"/>
                    <TextBlock Text="{Binding Destination}" Margin="0,0,19,0"/>
                    <TextBlock Text="Mozdonyvezető: " Foreground="#9CB7C8"/>
                    <TextBlock Text="{Binding DriverName}"/>
                </StackPanel>
                <Border Margin="0,12,0,0" Height="41" Width="480" HorizontalAlignment="Left"
                        Background="#1A394B" CornerRadius="12" BorderBrush="#447187" BorderThickness="1">
                    <Grid Margin="8,5">
                        <Border CornerRadius="13,5,5,13" Background="{Binding BodyBrush}" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,6,0,0">
                            <Border Background="#14344A" CornerRadius="3" Width="48" Height="10" Margin="0,0,9,0"/>
                            <Border Background="#14344A" CornerRadius="3" Width="48" Height="10" Margin="0,0,9,0"/>
                            <Border Background="#14344A" CornerRadius="3" Width="48" Height="10" Margin="0,0,9,0"/>
                            <Border Background="#14344A" CornerRadius="3" Width="48" Height="10"/>
                        </StackPanel>
                        <Border Height="10" VerticalAlignment="Bottom" Background="#123448"
                                CornerRadius="4" Margin="18,0,8,1">
                            <TextBlock Text="{Binding ConsistLabel}" FontSize="9" Foreground="#F7FCFF"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="MODERN RAIL • " Foreground="#66E6C7" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ConsistLabel}" Foreground="#B5CBD9" FontSize="10"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#61D7B4"/>
                <TextBlock Text="{Binding SpeedLabel}" HorizontalAlignment="Right" FontSize="18"/>
                <TextBlock Text="{Binding TrackLabel}" HorizontalAlignment="Right" Foreground="#9CB7C8"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Background="#152B38" BorderBrush="#365366" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,9,0">
                <StackPanel><TextBlock Text="ÜLŐHELY ÖSSZESEN" FontSize="11" Foreground="#A2BECD"/><TextBlock Text="{Binding SeatCapacity}" FontSize="29" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Background="#152B38" BorderBrush="#365366" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,9,0">
                <StackPanel><TextBlock Text="UTAS A VONATON" FontSize="11" Foreground="#A2BECD"/><TextBlock Text="{Binding PassengerCount}" FontSize="29" FontWeight="Bold" Foreground="#E8B16E"/></StackPanel>
            </Border>
            <Border Background="#152B38" BorderBrush="#365366" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,9,0">
                <StackPanel><TextBlock Text="SZABAD HELYEK" FontSize="11" Foreground="#A2BECD"/><TextBlock Text="{Binding FreeSeats}" FontSize="29" FontWeight="Bold" Foreground="#58DEB2"/></StackPanel>
            </Border>
            <Border Background="#152B38" BorderBrush="#365366" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="KIHASZNÁLTSÁG" FontSize="11" Foreground="#A2BECD"/>
                    <TextBlock Text="{Binding OccupancyText}" FontSize="29" FontWeight="Bold"/>
                    <ProgressBar Value="{Binding OccupancyPercent}" Minimum="0" Maximum="100"
                                 Height="8" Margin="0,5,0,0" Foreground="#38E3B9" Background="#355063"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border x:Name="PassengerLayout" Grid.Row="2" Background="#11202A" BorderBrush="#304757" BorderThickness="1" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,10,0">
                    <TextBlock DockPanel.Dock="Top" Text="KOCSIK" FontWeight="Bold" Margin="8,9,0,12"/>
                    <ListBox x:Name="CarriageList" ItemsSource="{Binding Carriages}" SelectionChanged="CarriageList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="1,5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="{Binding Category}" Foreground="#9BB7C7" FontSize="11"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="#61D7B4" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <Border Grid.Column="1" Background="#162B38" BorderBrush="#334D5D" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,3,0,12">
                            <TextBlock Text="{Binding SelectedItem.Name, ElementName=CarriageList}" HorizontalAlignment="Center" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="ABLAK  A / B     KÖZÉPFOLYOSÓ     C / D  ABLAK" HorizontalAlignment="Center" FontSize="10" Foreground="#A5C0CC" Margin="0,6,0,0"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedItem.Rows, ElementName=CarriageList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
                                            <Button Style="{StaticResource SeatButton}" DataContext="{Binding A}" Click="Seat_Click">
                                                <StackPanel><TextBlock Text="{Binding Label}" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding ShortName}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SeatButton}" DataContext="{Binding B}" Click="Seat_Click">
                                                <StackPanel><TextBlock Text="{Binding Label}" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding ShortName}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80"/></StackPanel>
                                            </Button>
                                            <Border Width="31" Background="#25445A" CornerRadius="11" Margin="5,8" VerticalAlignment="Stretch">
                                                <TextBlock Text="⇅" Foreground="#A8CBDC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Style="{StaticResource SeatButton}" DataContext="{Binding C}" Click="Seat_Click">
                                                <StackPanel><TextBlock Text="{Binding Label}" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding ShortName}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SeatButton}" DataContext="{Binding D}" Click="Seat_Click">
                                                <StackPanel><TextBlock Text="{Binding Label}" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding ShortName}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="UTASLISTA • KIJELÖLT KOCSI" FontWeight="Bold" Margin="5,6,0,10"/>
                        <DataGrid ItemsSource="{Binding SelectedItem.Manifest, ElementName=CarriageList}" Margin="3" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ülés" Binding="{Binding Label}" Width="48"/>
                                <DataGridTextColumn Header="Utas neve" Binding="{Binding Passenger.Name}" Width="*"/>
                                <DataGridTextColumn Header="Jegy" Binding="{Binding Passenger.Ticket}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#203442" CornerRadius="8" Padding="10" Margin="3,12,3,3">
                        <StackPanel>
                            <TextBlock Text="HELYSZERKESZTÉS (SZIMULÁCIÓ)" FontWeight="Bold" Foreground="#BFD7E5"/>
                            <TextBlock x:Name="SeatInfo" Text="Válassz egy ülést a rajzon!" TextWrapping="Wrap" Margin="0,7,0,5"/>
                            <TextBox x:Name="PassengerNameBox" Height="30" Padding="7,5" Background="#F0F6F9" Foreground="#142330" ToolTip="Utas neve"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Utas beültetése" Click="Board_Click" Style="{StaticResource AccentButton}"/>
                                <Button Content="Hely felszabadítása" Click="Remove_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="FreightBanner" Grid.Row="2" Visibility="Collapsed" Background="#142B3A" BorderBrush="#365568" BorderThickness="1" CornerRadius="10" Padding="32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="TEHERVONAT • NINCS UTASTÉR" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Ez a szerelvény árut szállít. Nem rendelkezik utasülésekkel vagy utasjegyzékkel." FontSize="14" Margin="0,13,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Border Background="#155047" Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"/>
            <TextBlock Text="Szabad" Margin="0,0,20,0"/>
            <Border Background="#634932" Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"/>
            <TextBlock Text="Foglalt" Margin="0,0,20,0"/>
            <TextBlock Text="A nevek és a helyfoglaltság generált, oktatási szimulációs adatok." Foreground="#93AFBD"/>
        </StackPanel>
    </Grid>
</Window>
