<Window x:Class="Vaganymester.NetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VÁGÁNYMESTER | Országos forgalmi központ"
        Width="1460" Height="920" MinWidth="1120" MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="108"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="VÁGÁNYMESTER  /  HÁLÓZATI FORGALOMIRÁNYÍTÁS"
                           FontSize="23" FontWeight="Bold" Foreground="#F4F9FF"/>
                <TextBlock Text="Öt pályaudvar • élő vonatmozgás • manuális és automatikus forgalomirányítás"
                           Foreground="#AFCDD9" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#183345" CornerRadius="8" Padding="13,9" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SZIMULÁCIÓS IDŐ  " Foreground="#B2C8D8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Engine.ClockText}" FontSize="19" FontWeight="Bold" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
                <Button Content="Napló exportálása" Click="ExportJournal_Click"/>
                <Button Content="Állomási kezelőpult" Click="MainPanel_Click" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Margin="0,0,9,0" Background="#163246" BorderBrush="#2D546B" BorderThickness="1" CornerRadius="10" Padding="16,11">
                <StackPanel><TextBlock Text="KÖZLEKEDŐ VONATOK" Foreground="#B5CFDD" FontSize="11"/>
                    <TextBlock Text="{Binding MovingCount}" FontSize="30" FontWeight="Bold" Foreground="#39DEC1"/></StackPanel>
            </Border>
            <Border Margin="0,0,9,0" Background="#163246" BorderBrush="#2D546B" BorderThickness="1" CornerRadius="10" Padding="16,11">
                <StackPanel><TextBlock Text="VÁRAKOZÓ ÉRKEZÉSEK" Foreground="#B5CFDD" FontSize="11"/>
                    <TextBlock Text="{Binding Engine.WaitingCount}" FontSize="30" FontWeight="Bold" Foreground="#FFD17D"/></StackPanel>
            </Border>
            <Border Margin="0,0,9,0" Background="#163246" BorderBrush="#2D546B" BorderThickness="1" CornerRadius="10" Padding="16,11">
                <StackPanel><TextBlock Text="KÉSŐ VONATOK (+15 MP)" Foreground="#B5CFDD" FontSize="11"/>
                    <TextBlock Text="{Binding DelayedCount}" FontSize="30" FontWeight="Bold" Foreground="#F6A9B0"/></StackPanel>
            </Border>
            <Border Background="#163246" BorderBrush="#2D546B" BorderThickness="1" CornerRadius="10" Padding="16,11">
                <StackPanel><TextBlock Text="IRÁNYÍTÁSI MÓD" Foreground="#B5CFDD" FontSize="11"/>
                    <TextBlock Text="{Binding ModeLabel}" FontSize="16" FontWeight="Bold" Foreground="#5EEDD0" Margin="0,10,0,0"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="#0F2333" BorderBrush="#34556A"
                BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="5,2,5,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="#39E7C7" Margin="0,0,9,0"/>
                        <TextBlock Text="ÉLŐ HÁLÓZATI TÉRKÉP" FontWeight="Bold" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Állomásra kattintva kezeld a csatlakozó vonalat. A vonatokra kattintva megnyílik az utastér."
                               Foreground="#B2C8D8" FontSize="11"/>
                </Grid>
                <Viewbox Grid.Row="1" Stretch="Uniform">
                    <Grid Width="1190" Height="400">
                        <Canvas Width="1190" Height="400" Background="#0A1C29">
                            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1190" Height="400" Fill="#0A1C29" RadiusX="10" RadiusY="10"/>
                            <Line X1="75" Y1="236" X2="1120" Y2="236" Stroke="#54778B" StrokeThickness="12" StrokeDashArray="0.7,0.6"/>
                            <Line X1="75" Y1="236" X2="1120" Y2="236" Stroke="#A6C6D9" StrokeThickness="3" />
                            <Line X1="75" Y1="95" X2="1120" Y2="95" Stroke="#1D4356" StrokeThickness="1" StrokeDashArray="4,8"/>
                            <TextBlock Canvas.Left="42" Canvas.Top="27" Text="NYUGATI TÉRSÉG" FontSize="18" FontWeight="Bold" Foreground="#8AB1C9"/>
                            <TextBlock Canvas.Left="485" Canvas.Top="27" Text="KŐRÖSPATAK · REGIONÁLIS KÖZPONT" FontSize="16" FontWeight="Bold" Foreground="#E2F4FC"/>
                            <TextBlock Canvas.Left="999" Canvas.Top="27" Text="KELETI TÉRSÉG" FontSize="18" FontWeight="Bold" Foreground="#8AB1C9"/>
                            <Border Canvas.Left="350" Canvas.Top="109" Background="#143347" CornerRadius="5" Padding="10,6">
                                <TextBlock Text="Nyugati bejárat / kijárat" Foreground="#F3D69B" FontSize="11"/>
                            </Border>
                            <Border Canvas.Left="758" Canvas.Top="109" Background="#143347" CornerRadius="5" Padding="10,6">
                                <TextBlock Text="Keleti bejárat / kijárat" Foreground="#F3D69B" FontSize="11"/>
                            </Border>
                            <TextBlock Canvas.Left="91" Canvas.Top="379" Text="Szimulált kapcsolatok • a csomópontok közötti útvonal vázlatos" Foreground="#839FB0" FontSize="10"/>
                        </Canvas>
                        <ItemsControl ItemsSource="{Binding Stations}" Width="1190" Height="400">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="Station_Click" Width="186" Height="104"
                                            Background="#1D3A4C" BorderBrush="#59AEC0" BorderThickness="1"
                                            Padding="7" ToolTip="Állomási információk és forgalmi engedélyek">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Code}" Foreground="#4DE7C8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#F0F8FD" FontWeight="Bold" TextAlignment="Center" Margin="0,3,0,3"/>
                                            <TextBlock Text="{Binding Role}" FontSize="10" Foreground="#B2D1DC" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding Activity}" FontSize="10" Foreground="#FFD38A" TextAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Markers}" Width="1190" Height="400">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="Marker_Click" Width="80" Height="27"
                                            Padding="2" BorderThickness="1" Background="#102C3E"
                                            BorderBrush="{Binding TrainBrush}" ToolTip="{Binding Status}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding TrainBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="Bold" Foreground="#F1F8FC" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
                <Border Grid.Row="2" Background="#1A394B" CornerRadius="6" Padding="12,8">
                    <TextBlock Text="{Binding Engine.WaitingSummary}" Foreground="#F5D4A0" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#122B3B" BorderBrush="#35576C" BorderThickness="1"
                    CornerRadius="10" Padding="14" Margin="0,0,11,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="KIVÁLASZTOTT ÁLLOMÁS: " Foreground="#AFCFDE" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding SelectedStation.Name}" FontWeight="Bold" FontSize="13" Foreground="#56EBD1"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedSummary}" Foreground="#BCD5DF"
                               TextWrapping="Wrap" FontSize="12" Margin="0,10,0,7"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Button Content="{Binding EntryButtonText}" Click="ToggleEntry_Click" IsEnabled="{Binding CanControlSelectedLine}" Style="{StaticResource AccentButton}"/>
                            <Button Content="{Binding ExitButtonText}" Click="ToggleExit_Click" IsEnabled="{Binding CanControlSelectedLine}"/>
                            <Button Content="VÉSZLEÁLLÍTÁS" Click="AllStop_Click" Style="{StaticResource DangerButton}"/>
                            <Button Content="Forgalom feloldása" Click="Resume_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <CheckBox Content="Automata jelző- és váltókezelés"
                                      IsChecked="{Binding Engine.AutoDispatchEnabled, Mode=TwoWay}" FontWeight="SemiBold"/>
                            <CheckBox Content="IC-előny a beléptetésnél"
                                      IsChecked="{Binding Engine.InterCityPriority, Mode=TwoWay}"/>
                            <CheckBox Content="1. vágány lezárva (munka)"
                                      IsChecked="{Binding Engine.Track1Closed, Mode=TwoWay}"/>
                            <CheckBox Content="2. vágány lezárva (munka)"
                                      IsChecked="{Binding Engine.Track2Closed, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="#122B3B" BorderBrush="#35576C" BorderThickness="1"
                    CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MENETEK / ÉLŐ HÁLÓZATI INFORMÁCIÓ"
                               FontSize="13" FontWeight="Bold" Margin="2,0,0,10"/>
                    <DataGrid ItemsSource="{Binding Markers}" IsReadOnly="True" Margin="0,0,0,3"
                              HeadersVisibility="Column" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VONAT" Binding="{Binding Number}" Width="76"/>
                            <DataGridTextColumn Header="IRÁNY" Binding="{Binding DirectionText}" Width="86"/>
                            <DataGridTextColumn Header="ÁLLAPOT" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
