<Window x:Class="Vaganymester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VÁGÁNYMESTER | Forgalmi szolgálattevő szimulátor"
        Width="1580" Height="950" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="236"/>
        </Grid.RowDefinitions>

        <!-- Fejléc és szimulációvezérlés -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="29" FontWeight="Bold" Text="VÁGÁNYMESTER"/>
                <TextBlock Foreground="#91ADBC" FontSize="12" Text="KŐRÖSPATAK ÁLLOMÁS   /   OKTATÁSI FORGALOMIRÁNYÍTÓ SZIMULÁTOR"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Idő: " Foreground="#9FB8C7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding ClockText}" FontSize="23" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <Button Content="◉ HÁLÓZATI TÉRKÉP" Click="Network_Click" ToolTip="Ötállomásos hálózati nézet"/> 
                <Button Content="{Binding RunButtonText}" Click="PlayPause_Click" Style="{StaticResource AccentButton}"/>
                <Button Content="+1 mp" ToolTip="A szimuláció egy másodperces léptetése" Click="Step_Click"/>
                <Button Content="↻  Újraindítás" Click="Reset_Click" Style="{StaticResource DangerButton}"/>
                <TextBlock Text="Sebesség:" Foreground="#9FB8C7" VerticalAlignment="Center" Margin="14,0,5,0"/>
                <Slider Width="100" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding TimeFactor, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TimeFactorText}" FontWeight="Bold" Width="30" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Élő állomási állapot -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#142530" BorderBrush="#2D4654" BorderThickness="1" CornerRadius="9" Margin="0,0,8,0" Padding="14,8">
                <StackPanel>
                    <TextBlock Text="AKTÍV VONATOK" Foreground="#B6D0DF" FontSize="11"/>
                    <TextBlock Text="{Binding ActiveCount}" FontSize="27" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#142530" BorderBrush="#2D4654" BorderThickness="1" CornerRadius="9" Margin="0,0,8,0" Padding="14,8">
                <StackPanel>
                    <TextBlock Text="TELJESÍTETT MENETEK" Foreground="#9AB4C3" FontSize="11"/>
                    <TextBlock Text="{Binding ArrivedCount}" FontSize="27" FontWeight="Bold" Foreground="#5AE3B6"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#142530" BorderBrush="#2D4654" BorderThickness="1" CornerRadius="9" Margin="0,0,8,0" Padding="14,8">
                <StackPanel>
                    <TextBlock Text="BALESETEK" Foreground="#9AB4C3" FontSize="11"/>
                    <TextBlock Text="{Binding CollisionCount}" FontSize="27" FontWeight="Bold" Foreground="#FF9DA5"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#142530" BorderBrush="#2D4654" BorderThickness="1" CornerRadius="9" Padding="14,8">
                <StackPanel>
                    <TextBlock Text="VONAL / BIZTOSÍTÁS" Foreground="#9AB4C3" FontSize="11"/>
                    <CheckBox Content="Vágányút-ellenőrzés bekapcsolva" FontSize="12"
                              IsChecked="{Binding SafetyEnabled, Mode=TwoWay}"/>
                    <CheckBox Content="Automata jelző- és váltókezelés" FontSize="12"
                              IsChecked="{Binding AutoDispatchEnabled, Mode=TwoWay}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="398"/>
            </Grid.ColumnDefinitions>

            <!-- Állomási térkép -->
            <Border Grid.Column="0" CornerRadius="11" Background="#111F29" BorderBrush="#2C4655" BorderThickness="1" Margin="0,0,12,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4,2,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ÉLŐ VÁGÁNYRAJZ" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Grid.Column="1" Text="Kattints egy vonatra az utastér megnyitásához!" Foreground="#85A3B6" FontSize="12"/>
                    </Grid>

                    <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid Width="1200" Height="370">
                            <Canvas Width="1200" Height="370" Background="#0D1922">
                                <!-- Térkép koordináták -->
                                <Line X1="25" Y1="70" X2="1174" Y2="70" Stroke="#213444" StrokeThickness="1" StrokeDashArray="5,6"/>
                                <Line X1="25" Y1="352" X2="1174" Y2="352" Stroke="#213444" StrokeThickness="1" StrokeDashArray="5,6"/>
                                <TextBlock Canvas.Left="35" Canvas.Top="10" Text="NYUGATI VONAL" FontSize="17" FontWeight="Bold" Foreground="#7999AB"/>
                                <TextBlock Canvas.Left="1025" Canvas.Top="10" Text="KELETI VONAL" FontSize="17" FontWeight="Bold" Foreground="#7999AB"/>
                                <TextBlock Canvas.Left="488" Canvas.Top="14" Text="KŐRÖSPATAK ÁLLOMÁS" FontSize="18" FontWeight="Bold" Foreground="#C9E1EF"/>
                                <TextBlock Canvas.Left="38" Canvas.Top="92" Text="{Binding WestSectionLabel}" Foreground="{Binding WestSectionBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Canvas.Left="1013" Canvas.Top="92" Text="{Binding EastSectionLabel}" Foreground="{Binding EastSectionBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Canvas.Left="509" Canvas.Top="111" Text="{Binding Track1SectionLabel}" Foreground="{Binding Track1SectionBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Canvas.Left="510" Canvas.Top="355" Text="{Binding Track2SectionLabel}" Foreground="{Binding Track2SectionBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Canvas.Left="36" Canvas.Top="236" Text="A VONAL" Foreground="#7894A5"/>
                                <TextBlock Canvas.Left="1027" Canvas.Top="236" Text="B VONAL" Foreground="#7894A5"/>

                                <!-- Peronok -->
                                <Rectangle Canvas.Left="451" Canvas.Top="222" Width="251" Height="13" Fill="#415667" RadiusX="4" RadiusY="4"/>
                                <Rectangle Canvas.Left="451" Canvas.Top="344" Width="251" Height="11" Fill="#415667" RadiusX="4" RadiusY="4"/>
                                <TextBlock Canvas.Left="523" Canvas.Top="239" Text="1. PERON" Foreground="#AEC7D8" FontSize="11"/>
                                <TextBlock Canvas.Left="523" Canvas.Top="327" Text="2. PERON" Foreground="#AEC7D8" FontSize="11"/>
                                <TextBlock Canvas.Left="487" Canvas.Top="163" Text="1. VÁGÁNY • ÁTMENŐ FŐVÁGÁNY" Foreground="#B0C7D4" FontSize="13"/>
                                <TextBlock Canvas.Left="505" Canvas.Top="287" Text="2. VÁGÁNY • MEGELŐZŐ" Foreground="#B0C7D4" FontSize="13"/>

                                <!-- Vasúti pálya: két sín és kitérő -->
                                <Path Data="M 28,195 L 1170,195" Stroke="#344653" StrokeThickness="15" StrokeDashArray="1.1,0.9"/>
                                <Path Data="M 28,195 L 1170,195" Stroke="#9FB2BE" StrokeThickness="5"/>
                                <Path Data="M 325,195 L 415,318 L 740,318 L 830,195" Stroke="#344653" StrokeThickness="15" StrokeDashArray="1.1,0.9"/>
                                <Path Data="M 325,195 L 415,318 L 740,318 L 830,195" Stroke="#9FB2BE" StrokeThickness="5"/>
                                <!-- Aktív váltóállások kiemelése -->
                                <Path Data="M 325,195 L 415,195" Stroke="{Binding WestTurnout.StraightBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M 325,195 L 415,318" Stroke="{Binding WestTurnout.BranchBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M 740,195 L 830,195" Stroke="{Binding EastTurnout.StraightBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M 740,318 L 830,195" Stroke="{Binding EastTurnout.BranchBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse Canvas.Left="318" Canvas.Top="188" Width="14" Height="14" Fill="#EEF8FD"/>
                                <Ellipse Canvas.Left="823" Canvas.Top="188" Width="14" Height="14" Fill="#EEF8FD"/>
                                <TextBlock Canvas.Left="30" Canvas.Top="295" Text="JELMAGYARÁZAT" Foreground="#8AA6B7" FontSize="11"/>
                                <Ellipse Canvas.Left="30" Canvas.Top="318" Width="11" Height="11" Fill="LimeGreen"/>
                                <TextBlock Canvas.Left="48" Canvas.Top="314" Text="szabad" Foreground="#A6C3D4"/>
                                <Ellipse Canvas.Left="121" Canvas.Top="318" Width="11" Height="11" Fill="OrangeRed"/>
                                <TextBlock Canvas.Left="140" Canvas.Top="314" Text="megállj" Foreground="#A6C3D4"/>
                                <Rectangle Canvas.Left="235" Canvas.Top="317" Width="26" Height="7" Fill="#48DFAF"/>
                                <TextBlock Canvas.Left="270" Canvas.Top="314" Text="aktív váltóút" Foreground="#A6C3D4"/>
                            </Canvas>

                            <ItemsControl ItemsSource="{Binding Signals}" Width="1200" Height="370">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="Signal_Click" Width="58" Height="52"
                                                Padding="0" BorderThickness="0" Background="Transparent"
                                                ToolTip="{Binding Description}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Background="#0A121A" BorderBrush="#708F9B" BorderThickness="2"
                                                        Width="26" Height="30" CornerRadius="5" HorizontalAlignment="Center">
                                                    <Ellipse Width="15" Height="15" Fill="{Binding LampBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Code}" HorizontalAlignment="Center"
                                                           FontSize="12" FontWeight="Bold" Foreground="#E3F2FA"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Turnouts}" Width="1200" Height="370">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="Turnout_Click" Width="130" Height="56"
                                                Padding="5,2" Background="#253B4B" BorderBrush="#5E8397">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Code}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding RouteText}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Trains}" Width="1200" Height="370">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="Train_Click" Width="80" Height="40"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                Padding="0" ToolTip="{Binding DriverName}">
                                            <Grid Margin="1">
                                                <Border CornerRadius="15,7,7,15" Background="{Binding BodyBrush}"
                                                        BorderBrush="#D2F4F5" BorderThickness="1"/>
                                                <Border Height="3" VerticalAlignment="Bottom" Margin="12,0,5,3"
                                                        Background="#112D3D" CornerRadius="2"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                            VerticalAlignment="Top" Margin="8,4,0,0">
                                                    <Border Width="15" Height="7" CornerRadius="3" Background="#1A394B" Margin="0,0,3,0"/>
                                                    <Border Width="13" Height="7" CornerRadius="2" Background="#1A394B" Margin="0,0,3,0"/>
                                                    <Border Width="13" Height="7" CornerRadius="2" Background="#1A394B"/>
                                                </StackPanel>
                                                <Border Margin="11,16,5,5" Background="#112A3A" CornerRadius="4" Opacity="0.93"/>
                                                <StackPanel VerticalAlignment="Bottom" Margin="13,0,7,7">
                                                    <TextBlock Text="{Binding Number}" FontSize="10" FontWeight="Bold"
                                                               TextAlignment="Center" Foreground="#F1FCFC"/>
                                                    <TextBlock Text="{Binding SpeedLabel}" FontSize="8" TextAlignment="Center"
                                                               Foreground="#B8DBDE"/>
                                                </StackPanel>
                                                <Ellipse Width="4" Height="4" Fill="#FFF5D0" HorizontalAlignment="Left"
                                                         VerticalAlignment="Bottom" Margin="3,0,0,9"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>

                    <Border Grid.Row="2" Background="#1C303E" CornerRadius="6" Padding="10,9" Margin="0,3,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SystemMessage}" Foreground="#F0F6FC" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="{Binding WaitingSummary}" Foreground="#FBC87D" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding DelaySummary}" Foreground="#F8BBBA" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ÚJ RENDKÍVÜLI VONAT" FontWeight="Bold" Foreground="#A8C3D2" VerticalAlignment="Center" Margin="2,0,12,0"/>
                        <ComboBox x:Name="DirectionPicker" SelectedIndex="0" Width="140" Margin="0,0,7,0" Background="#E8F2F8" Foreground="#12283A">
                            <ComboBoxItem Content="Nyugatról érkezik"/>
                            <ComboBoxItem Content="Keletről érkezik"/>
                        </ComboBox>
                        <ComboBox x:Name="TrainTypePicker" SelectedIndex="0" Width="133" Margin="0,0,7,0" Background="#E8F2F8" Foreground="#12283A">
                            <ComboBoxItem Content="Személyvonat"/>
                            <ComboBoxItem Content="InterCity"/>
                            <ComboBoxItem Content="Tehervonat"/>
                        </ComboBox>
                        <Button Content="+ Érkezés kérése" ToolTip="Foglalt vonalnál a járat várólistára kerül." Click="AddTrain_Click" Style="{StaticResource AccentButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Kezelőpult -->
            <Border Grid.Column="1" Background="#14212D" BorderBrush="#304A5A" CornerRadius="11" BorderThickness="1" Padding="9">
                <TabControl>
                    <TabItem Header="JELZŐ / VÁLTÓ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12,13">
                                <TextBlock Text="Kijelölt jelző" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding Signals}" SelectedItem="{Binding SelectedSignal, Mode=TwoWay}" Height="170">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Code}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11" Foreground="#9AB6C6" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Aspect}" Foreground="{Binding LampBrush}" FontSize="11" FontWeight="Bold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,5">
                                    <Button Content="●  SZABAD" Click="SignalGreen_Click" Style="{StaticResource AccentButton}" Width="147"/>
                                    <Button Content="●  MEGÁLLJ" Click="SignalRed_Click" Style="{StaticResource DangerButton}" Width="147"/>
                                </StackPanel>
                                <Separator Margin="0,7" Background="#37505F"/>
                                <TextBlock Text="Kijelölt váltó" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding Turnouts}" SelectedItem="{Binding SelectedTurnout, Mode=TwoWay}" Height="86">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Code}" FontWeight="Bold" Width="44"/>
                                                <TextBlock Text="{Binding RouteText}" Foreground="#B8D0DF"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="⇄  Váltó átállítása" Click="ToggleTurnout_Click" Margin="2,8"/>
                                <TextBlock Text="{Binding SelectedTurnout.LockText}" Foreground="#F1C982" FontWeight="Bold" Margin="4,0,0,0"/>
                                <TextBlock Text="Biztonságos üzemben a foglalt vágányút nem nyitható meg, a lezárt váltó nem állítható át."
                                           TextWrapping="Wrap" Foreground="#98B3C1" FontSize="12" Margin="0,9,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="VONATOK">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12,13">
                                <TextBlock Text="Kijelölt vonat / mozdonyvezető" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding Trains}" SelectedItem="{Binding SelectedTrain, Mode=TwoWay}" MouseDoubleClick="TrainList_MouseDoubleClick" Height="154">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="#B3CDDC"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SpeedLabel}" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="🚃  Vonat belső nézete / ülésrajz" Click="TrainDetails_Click"
                                        HorizontalAlignment="Stretch" Margin="2,7" Style="{StaticResource AccentButton}"/>
                                <Grid Margin="2,12,2,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                                    <TextBlock Text="Vonat:" Foreground="#8FABBD"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTrain.Number, TargetNullValue=–}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Text="Mozdonyvezető:" Foreground="#8FABBD"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTrain.DriverName, TargetNullValue=–}"/>
                                    <TextBlock Grid.Row="2" Text="Irány:" Foreground="#8FABBD"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTrain.DirectionText, TargetNullValue=–}"/>
                                    <TextBlock Grid.Row="3" Text="Vágány:" Foreground="#8FABBD"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTrain.TrackLabel, TargetNullValue=–}"/>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="▶  Indulhat" Click="ResumeTrain_Click" Width="142" Style="{StaticResource AccentButton}"/>
                                    <Button Content="⏸  Álljon meg" Click="StopTrain_Click" Width="142"/>
                                    <Button Content="✖  Vészfék" Click="EmergencyTrain_Click" Width="142" Style="{StaticResource DangerButton}"/>
                                    <Button Content="⚠  Vörös meghaladása" Click="ForcePass_Click" Width="142" Style="{StaticResource DangerButton}" ToolTip="Oktatási kockázati helyzetet idéz elő"/>
                                </WrapPanel>
                                <TextBlock Text="A mozdonyvezető betartja a vörös jelzőt, kivéve ha veszélyes különutasítást adsz."
                                           Foreground="#9CB8C8" TextWrapping="Wrap" Margin="0,13,0,0" FontSize="12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="SZEMÉLYZET">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12,13">
                                <TextBlock Text="Mozdonyvezetői szolgálat" FontSize="15" FontWeight="Bold" Margin="0,0,0,9"/>
                                <ItemsControl ItemsSource="{Binding Drivers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1B303E" CornerRadius="7" Padding="9" Margin="0,0,0,7">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding RadioCode}" Foreground="#76C3D3" FontFamily="Consolas"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Experience}" Foreground="#8EADBF" FontSize="11"/>
                                                    <TextBlock FontSize="12"><Run Text="Beosztás: "/><Run Text="{Binding AssignedTrain}"/></TextBlock>
                                                    <TextBlock Text="{Binding RadioStatus}" Foreground="#B8D2DB" TextWrapping="Wrap" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="SÚGÓ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="13" >
                                <TextBlock Text="Forgalmi szolgálattevő feladata" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="1. A vonatok a nyílt vonalon várnak, amíg felszabadul a belépési oldal; nem spawnolnak a kihaladó szerelvény elé." TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="2. Válaszd ki a nyugati vagy keleti váltó útirányát: 1. vagy 2. vágány." TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="3. Állítsd a megfelelő bejárati jelzőt SZABAD-ra. A vonat önállóan elindul és áthalad." TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="4. Mielőtt elhagyja az állomást, állítsd a kijárati jelzőt is SZABAD-ra, és a kijárati oldalon lévő váltót a megfelelő vágányra." TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="5. Az ütközésveszély bemutatására a biztonságos ellenőrzés kikapcsolható, illetve vörösjelző-meghaladás adható utasításba." TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Separator Margin="0,8"/>
                                <TextBlock Text="Gyorsbillentyűk" FontWeight="Bold" Margin="0,5,0,6"/>
                                <TextBlock Text="SPACE: indítás/szünet"/>
                                <TextBlock Text="F2: új személyvonat nyugatról"/>
                                <TextBlock Text="F3: új személyvonat keletről"/>
                                <TextBlock Text="F5: egy másodperces léptetés"/>
                                <TextBlock Text="F9: szimuláció újraindítása"/>
                                <TextBlock Text="Fontos: fiktív pálya és egyszerűsített fizika. Ez nem valódi vasúti forgalomirányító eszköz."
                                           Foreground="#E4BA84" Margin="0,19,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Menetrend és forgalmi napló -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.16*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#14212D" BorderBrush="#2F4858" BorderThickness="1" CornerRadius="9" Margin="0,0,10,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MENETREND / FORGALMI JEGYZÉK" FontSize="14" FontWeight="Bold" Margin="4,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Timetable}" AlternationCount="2" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Idő" Binding="{Binding DueTime}" Width="81"/>
                            <DataGridTextColumn Header="Vonat" Binding="{Binding Number}" Width="83"/>
                            <DataGridTextColumn Header="Belépés" Binding="{Binding Origin}" Width="75"/>
                            <DataGridTextColumn Header="Cél" Binding="{Binding Destination}" Width="*"/>
                            <DataGridTextColumn Header="Állapot" Binding="{Binding Status}" Width="156"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="#14212D" BorderBrush="#2F4858" BorderThickness="1" CornerRadius="9" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FORGALMI ÉS BIZTONSÁGI NAPLÓ" FontSize="14" FontWeight="Bold" Margin="4,0,0,8"/>
                    <ListBox ItemsSource="{Binding Journal}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" Foreground="#89A5B6"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding MessageBrush}"
                                               TextWrapping="Wrap" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
